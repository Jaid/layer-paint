{
  "name": "layer-paint",
  "displayName": "LayerPaint",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Non-destructive, multi-resolution image studio with a secure local Image API gateway",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/layer-paint.git"
  },
  "imports": {
    "#component/*": "./src/components/*/index.tsx",
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "bun run vite build && bun scripts/check-secrets.ts",
    "build:development": "bun run vite build --mode development",
    "check": "bun run lint && bun run test && bun run build && bun run test-browser",
    "dev": "bun scripts/dev.ts",
    "lint": "tsc --noEmit --noUnusedLocals --pretty false",
    "start": "bun scripts/server.ts",
    "test": "bun test --max-concurrency 1 ./test && bun run test-dom",
    "test-browser": "bun scripts/test-browser.ts",
    "test-dom": "bun test --preload ./test/happydom.ts ./test/components.dom.ts",
    "vite": "bun --bun node_modules/vite/dist/node/cli --configLoader native"
  },
  "overrides": {
    "typescript": "npm:typescript-classic@6.0.4"
  },
  "patchedDependencies": {
    "happy-dom@20.14.5": "patches/happy-dom@20.14.5.patch",
    "monacozen@0.5.1": "patches/monacozen@0.5.1.patch"
  },
  "dependencies": {
    "antimono": "0.1.0",
    "clsx": "^2.1.1",
    "idb": "8.0.4",
    "lucide-react": "1.52.0",
    "monacozen": "0.5.1",
    "mount-root": "0.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "20.1.2",
    "react-resizable-panels": "4.14.2",
    "read-permalink": "0.4.0",
    "@jsquash/jxl": "1.3.0"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "eslint-config-jaid": "34.0.0",
    "puppeteer-core": "25.12.0",
    "sass-embedded": "1.105.1",
    "tsconfig-jaid-react": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "vite": "8.3.3",
    "vite-plugin-media-mixins": "0.10.0",
    "vite-plugin-title": "0.6.0",
    "@happy-dom/global-registrator": "20.14.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
